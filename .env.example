# ── Credential resolution ─────────────────────────────────────────
# The server resolves the API key in this order:
#   1. KINSTA_API_KEY env var (below)
#   2. KINSTA_API_KEY_FILE env var (path to a file holding the key)
#   3. Default credential file: ~/.config/kinsta-mcp/api-key (mode 0600)
# The company ID resolves as: KINSTA_COMPANY_ID env → ~/.config/kinsta-mcp/company-id.
#
# Recommended for a key shared across projects: skip the env vars entirely,
# write the key once to the default files, and keep each project's .mcp.json a
# bare launch block (no `env` needed). Set up the files with:
#   mkdir -p -m 700 ~/.config/kinsta-mcp
#   printf %s 'YOUR_KEY'        > ~/.config/kinsta-mcp/api-key
#   printf %s 'YOUR_COMPANY_ID' > ~/.config/kinsta-mcp/company-id
#   chmod 600 ~/.config/kinsta-mcp/api-key ~/.config/kinsta-mcp/company-id

# Optional: your Kinsta API key (Bearer token). Overrides the credential file.
# Create one in MyKinsta > Company settings > API Keys.
KINSTA_API_KEY=

# Default company ID used by company-scoped tools (list_sites, domains,
# analytics, regions, users, api-keys, activity-logs). Every tool that
# uses it also accepts a per-call `company_id` override.
# Found in the MyKinsta URL: https://my.kinsta.com/?idCompany=<THIS>
KINSTA_COMPANY_ID=

# ── Optional tuning ───────────────────────────────────────────────
# Max concurrent non-creation requests (default 5).
# KINSTA_MAX_CONCURRENT_REQUESTS=5
# Max creation requests per minute (Kinsta caps this at 5; default 5).
# KINSTA_CREATION_PER_MINUTE=5
# Max ms to wait on a 429 retry before giving up (default 30000).
# KINSTA_MAX_RETRY_DELAY_MS=30000
# Max retries on 429 (default 3).
# KINSTA_MAX_RETRIES=3

# ── Destructive-op guard (optional) ───────────────────────────────
# Override the Claude Code transcript directory the guard reads to
# verify your typed authorization. Defaults to
# ~/.claude/projects/<encoded-cwd>/. Only set this if you run the
# server from a non-standard location.
# KINSTA_TRANSCRIPT_DIR=
